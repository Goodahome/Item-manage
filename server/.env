# 数据库连接URL
# 格式: mysql://用户密码@主机:端口/数据库名
DATABASE_URL="mysql://root:Admin@123@localhost:3306/itemreminder"

# JWT 密钥（开发环境示例，生产环境务必修改
JWT_SECRET="dev_secret_key_change_this_in_production_32chars"

# JWT 过期时间7天）
JWT_EXPIRES_IN="7d"

# 服务器端
PORT=3001

# 运行环境
NODE_ENV="development"

# 连接数和请求数限制
RATE_LIMIT_API_MAX=9999999
RATE_LIMIT_AUTH_MAX=9999999
RATE_LIMIT_WINDOW_MS=9999999

# 图片同步
STORAGE_ENDPOINT=http://192.168.124.2:9000
STORAGE_BUCKET=itemremindertool
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=auto
STORAGE_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300
IMAGE_MAX_BYTES=5242880

# 图片加密存储
STORAGE_SSE=AES256
# 若用 KMS:
# STORAGE_SSE=aws:kms
# STORAGE_SSE_KMS_KEY=xxxx