# 数据库配置（推荐方式 - 分开配置，自动处理特殊字符）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD="RVx#PmU3"
DB_NAME=itemreminder

# 数据库连接URL（如果设置了上面的分开配置，此配置会被自动构建，无需手动设置）
# 格式: mysql://用户:密码@主机:端口/数据库名
# 注意：如果密码包含特殊字符（如 @、:、/、% 等），请使用上面的分开配置方式
# DATABASE_URL="mysql://root:Admin%40123@localhost:3306/itemreminder"

# JWT 密钥（开发环境示例，生产环境务必修改
JWT_SECRET="dev_secret_key_change_this_in_production_32chars"

# JWT 过期时间7天）
JWT_EXPIRES_IN="7d"

# 服务器端
PORT=3001

# 运行环境
NODE_ENV="development"

# 连接数和请求数限制
RATE_LIMIT_API_MAX=9999999
RATE_LIMIT_AUTH_MAX=9999999
RATE_LIMIT_WINDOW_MS=9999999

# 图片同步
# MinIO API 端点（注意：使用 --address 指定的端口，不是 --console-address）
STORAGE_ENDPOINT=http://182.140.144.150:21152
STORAGE_BUCKET=itemremindertool
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=auto
STORAGE_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300
IMAGE_MAX_BYTES=5242880

# 图片加密存储
# 注意：如果 MinIO 未配置 KMS，请禁用服务器端加密（设置为空或注释掉）
# STORAGE_SSE=AES256
# 若用 KMS:
# STORAGE_SSE=aws:kms
# STORAGE_SSE_KMS_KEY=xxxx